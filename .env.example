# Google Apps Script Web App URL
# Obtained from: Google Sheet -> Extensions -> Apps Script -> Deploy as Web App
# Note: In production or local development, you can also paste this directly in the app's Settings modal.
VITE_GOOGLE_APPS_SCRIPT_URL=

# Firebase Authentication Configuration
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
